OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CURATOR_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Opcional; si se omite, el MVP local deriva la clave de GOOGLE_CLIENT_SECRET.
OAUTH_TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/meetagent
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
SUPABASE_URL=
SUPABASE_JWT_SECRET=
MEETING_INTERVENTION_BUDGET=4
CURATOR_POLL_INTERVAL_MS=1500
ALLOW_LOCAL_IDENTITY=true
LOCAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
LOCAL_USER_ID=00000000-0000-0000-0000-000000000002
LOCAL_USER_EMAIL=local@example.com
DEMO_MODE=false
SEED_DEMO_DATA=false
# El visor de memoria queda disponible en http://localhost:3000/memory-observer
