{
  "name": "meet-agent",
  "version": "1.0.0",
  "description": "A proactive AI agent that lives inside Google Meet and turns live conversation into contextual actions.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test-agent": "tsx src/index.ts",
    "demo-memory": "DEMO_MODE=true tsx src/demo.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/001_contextual_memory.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/002_memory_observer.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f demo/seed.sql",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "keywords": [
    "ai-agent",
    "google-meet",
    "openai",
    "chrome-extension",
    "google-calendar"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@openai/agents": "^0.17.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^178.1.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
